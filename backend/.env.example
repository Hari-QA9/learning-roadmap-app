# Copy to backend/.env and fill in.
DB_PASSWORD=your_mysql_root_password
JWT_SECRET=any_long_random_string
GEMINI_API_KEY=your_gemini_api_key
# Optional: change the AI model in one place (default gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
PORT=5000

# Optional: where the frontend runs (used in password-reset links)
APP_URL=http://localhost:3000
# Optional: send real emails (password reset). Without these, the reset link
# is printed in the backend terminal instead. For Gmail, use an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=LearnMap <you@gmail.com>

# Job board (all optional). Works with no keys at all; keys add more jobs.
# Sources to use (remove any you don't want). Keyed sources stay off until their key is set.
JOB_SOURCES=remotive,arbeitnow,themuse,greenhouse,lever,ashby,adzuna,usajobs,jsearch
# How often to pull new jobs, in hours
JOB_REFRESH_HOURS=6
# Company career boards. Leave empty to use the built-in list (~55 tech companies).
# The name is the one in boards.greenhouse.io/<name>, jobs.lever.co/<name>, jobs.ashbyhq.com/<name>
GREENHOUSE_BOARDS=
LEVER_COMPANIES=
ASHBY_COMPANIES=
# Search terms for Adzuna and JSearch (comma separated)
JOB_QUERIES=software engineer,qa automation engineer,data analyst,data engineer,frontend developer,devops engineer

# Adzuna — free key from https://developer.adzuna.com (about 250 searches/day)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us
# USAJobs — free key from https://developer.usajobs.gov (email = the one you registered with)
USAJOBS_API_KEY=
USAJOBS_EMAIL=
USAJOBS_KEYWORDS=software,information technology,data
# JSearch (paid, optional) — adds LinkedIn / Indeed / Glassdoor listings via Google for Jobs.
# Subscribe on RapidAPI (search "JSearch") and paste the key. Each search = 1 request.
JSEARCH_API_KEY=
JSEARCH_LOCATION=United States

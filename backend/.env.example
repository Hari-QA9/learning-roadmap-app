# Copy to backend/.env and fill in.
DB_PASSWORD=your_mysql_root_password
JWT_SECRET=any_long_random_string
GEMINI_API_KEY=your_gemini_api_key
# Optional: change the AI model in one place (default gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
PORT=5000

# Optional: where the frontend runs (used in password-reset links)
APP_URL=http://localhost:3000
# Optional: send real emails (password reset). Without these, the reset link
# is printed in the backend terminal instead. For Gmail, use an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=LearnMap <you@gmail.com>

# Job board (all optional). Works with no keys at all; keys add more jobs.
# Sources to use (remove any you don't want). Keyed sources stay off until their key is set.
JOB_SOURCES=remotive,arbeitnow,themuse,greenhouse,lever,ashby,adzuna,usajobs,jsearch
# How often to pull new jobs, in hours
JOB_REFRESH_HOURS=6
# Company career boards. Leave empty to use the built-in list (~55 tech companies).
# The name is the one in boards.greenhouse.io/<name>, jobs.lever.co/<name>, jobs.ashbyhq.com/<name>
GREENHOUSE_BOARDS=
LEVER_COMPANIES=
ASHBY_COMPANIES=
# Search terms for Adzuna, USAJobs and JSearch. Members' own target roles are always searched first;
# these top them up. Leave empty for a broad built-in mix (tech, science, health, finance, marketing, engineering, teaching).
JOB_QUERIES=
# How many searches per refresh for each keyed source (keeps you inside free limits)
ADZUNA_MAX_QUERIES=12
USAJOBS_MAX_QUERIES=8
JSEARCH_MAX_QUERIES=4
# The Muse categories (leave empty for all fields)
MUSE_CATEGORIES=

# Adzuna — free key from https://developer.adzuna.com (about 250 searches/day)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us
# USAJobs — free key from https://developer.usajobs.gov (email = the one you registered with)
USAJOBS_API_KEY=
USAJOBS_EMAIL=
# Optional fixed USAJobs keywords (otherwise uses members' roles + the mix above)
USAJOBS_KEYWORDS=
# JSearch (paid, optional) — adds LinkedIn / Indeed / Glassdoor listings via Google for Jobs.
# Subscribe on RapidAPI (search "JSearch") and paste the key. Each search = 1 request.
JSEARCH_API_KEY=
JSEARCH_LOCATION=United States

# Learning resources (optional). With a YouTube key, roadmap video resources link to a real video
# instead of a YouTube search. Free key: Google Cloud Console → enable "YouTube Data API v3" → Credentials.
YOUTUBE_API_KEY=

# Reminders, weekly summaries, job alerts and follow-ups (run hourly in the backend).
# Public address of this backend's /api — used for one-click unsubscribe links in emails.
PUBLIC_API_URL=http://localhost:5000/api
# Lowest match % that triggers a job alert
JOB_ALERT_MIN_MATCH=70
# Set to 1 to turn the hourly reminders off (e.g. on a second server)
DISABLE_SCHEDULER=0

# Sign in with Google (optional). Create an OAuth client ID (type "Web application") at
# console.cloud.google.com → APIs & Services → Credentials, add your site address
# (e.g. http://localhost:3000 and https://your-domain) under "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=

# Admin dashboard (/admin): comma-separated emails that can open it
ADMIN_EMAILS=you@gmail.com

# Copy to backend/.env and fill in.
DB_PASSWORD=your_mysql_root_password
JWT_SECRET=any_long_random_string
GEMINI_API_KEY=your_gemini_api_key
# Optional: change the AI model in one place (default gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
PORT=5000

# Optional: where the frontend runs (used in password-reset links)
APP_URL=http://localhost:3000
# Optional: send real emails (password reset). Without these, the reset link
# is printed in the backend terminal instead. For Gmail, use an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=LearnMap <you@gmail.com>

# Job board (all optional). Jobs come from free public APIs — no keys needed.
# Sources to use (remove any you don't want):
JOB_SOURCES=remotive,arbeitnow,themuse,greenhouse,lever
# Company job boards to include (the name in boards.greenhouse.io/<name> or jobs.lever.co/<name>)
GREENHOUSE_BOARDS=stripe,airbnb,figma,discord,robinhood,duolingo,gitlab,dropbox
LEVER_COMPANIES=palantir,spotify
# How often to pull new jobs, in hours
JOB_REFRESH_HOURS=6

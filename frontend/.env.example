# Copy to frontend/.env only if you need to change these. (When hosted, set them in Vercel's settings.)

# Where the backend API is. Leave unset locally: the app uses port 5000 on the same computer,
# which also makes phones on your Wi-Fi work. In production set it to your backend, e.g.:
# REACT_APP_API_URL=https://learnmap-api.onrender.com/api

# Email address shown on the Privacy and Terms pages for questions
# REACT_APP_CONTACT_EMAIL=support@example.com
